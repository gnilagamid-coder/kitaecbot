# Скопируйте в .env и заполните.  cp .env.example .env

# Токен бота от @BotFather. Без него не работают: сам бот, аватарки
# пользователей, уведомления менеджеру и публикация в канал.
BOT_TOKEN=123456:AA...

# Пароль админки. Держите длинным: это и аварийный вход в панель (токен
# вводится в поле формы на /admin.html, в URL не пишется), и ключ, которым
# подписываются билеты входа из Telegram.
ADMIN_TOKEN=смените-обязательно

# Кому открыта админка из бота: chat_id владельцев через запятую.
# Свой chat_id узнаётся командой /id у бота. Необязательно: владельца можно
# добавить прямо в боте — /owner, пароль ADMIN_TOKEN, затем chat_id.
# Эти владельцы базовые: бот и панель их не убирают.
# ADMIN_CHAT_IDS=123456789

# Внутренний порт. Наружу его отдаёт nginx, слушаем только localhost.
PORT=3000
HOST=127.0.0.1

# Публичный адрес магазина со схемой. Нужен, чтобы Telegram мог забрать
# фото товара при публикации в канал.
PUBLIC_URL=https://shop.example.com

# Где лежат данные (JSON-файлы и картинки). По умолчанию ./data
DATA_DIR=./data

# Где хранить резервные копии (снимки из админки, вкладка «Бэкапы»).
# По умолчанию — папка backups/ рядом с DATA_DIR. Меняйте, чтобы вынести
# копии на отдельный диск/том.
# BACKUP_DIR=/var/backups/tg-shop

# Как бот получает сообщения: webhook (продакшен, ставит install.sh) или polling.
#   webhook — Telegram сам стучится на PUBLIC_URL/api/webhook. Нужен рабочий HTTPS
#             на порту 443/80/88/8443. Бот регистрируется сам при старте (setWebhook).
#   polling — запасной режим: работает сразу, даже пока домен и сертификат не готовы,
#             сам переподключается после сбоев сети. Код без BOT_MODE выбирает его.
# Отдельный секрет заводить не нужно — он выводится из токенов и ключей магазина.
BOT_MODE=polling

# Только для BOT_MODE=webhook: 1 запрещает тихий откат на polling при неудачной
# регистрации вебхука. Бот останется выключенным с записью в логе — для продакшена
# и нескольких экземпляров это правильно (два поллера на токен = вечный 409 Conflict).
# BOT_STRICT_WEBHOOK=1

# Адрес Bot API. Меняйте, только если сервер не может достучаться до Telegram
# напрямую (типичная история у российских хостеров: блокировка по IP или DPI).
# Укажите свой обратный прокси или локальный telegram-bot-api — БЕЗ /bot<token>.
# Проверить, есть ли проблема:  curl -sS -m 10 https://api.telegram.org | head
# TELEGRAM_API_BASE=https://tg-proxy.example.com

# MySQL (этап SaaS). Пока не задан MYSQL_HOST, магазин работает на файловом
# хранилище — БД нужна только миграциям:  node server/migrate.js up
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=kitaec
# MYSQL_PASSWORD=
# MYSQL_DATABASE=kitaec

# ---------- режим платформы (Stage 3) ----------
# MULTITENANT=1 включает многоарендность: один процесс обслуживает много
# магазинов, каждый на своём поддомене MULTITENANT_DOMAIN. Требует MySQL
# (MYSQL_HOST/MYSQL_DATABASE) и SECRET_KEY. Без MULTITENANT=1 всё работает
# в обычном файловом режиме одного магазина.
# MULTITENANT=1

# Базовый домен платформы: shop1.example.ru -> магазин shop1, голый домен —
# лендинг с регистрацией.
# MULTITENANT_DOMAIN=example.ru

# Корень папок данных магазинов платформы. По умолчанию ./data/shops
# MULTITENANT_DATA_ROOT=/opt/tg-shop/data/shops

# Ключ шифрования секретов арендаторов (токены ботов в БД). Минимум 12
# символов, держите в секрете: со сменой ключа старые токены не читаются.
# SECRET_KEY=смените-обязательно-длинная-строка

# ---------- биллинг платформы (Stage 5, опционально) ----------
# Подписка магазинов на Robokassa. Без ROBOKASSA_LOGIN/паролей биллинг
# выключен и все магазины работают бесплатно. На приём денег от покупателей
# (вкладка «Оплата» каждого магазина) это никак не влияет.
# Данные — из кабинета Robokassa: логин магазина и два пароля. Result URL:
# https://<MULTITENANT_DOMAIN>/api/platform/billing/result, метод POST.
# ROBOKASSA_LOGIN=myshop
# ROBOKASSA_PASS1=пароль-1
# ROBOKASSA_PASS2=пароль-2
# Тестовый режим кассы (платежи не списываются): 1 — включить.
# ROBOKASSA_IS_TEST=1
# Цена подписки в рублях и длины периодов в днях.
# BILLING_PRICE=990
# BILLING_PERIOD_DAYS=30
# Пробный период для новых магазинов (0 — без пробного периода).
# BILLING_TRIAL_DAYS=14

# Общий ключ с сайтом магазина (jokerphone-site и подобные): по нему сайт
# присылает боту заявки с формы, а бот рассылает их своим админам (/admins).
# Пусто — приём заявок с сайта выключен.
# SITE_LEAD_TOKEN=
#
# Сайт магазина как витрина (https://…). Тогда «Открыть магазин» и кнопка меню
# открывают сайт, «⚙️ Открыть панель» — админку сайта (вход по Telegram: сайт
# спрашивает бота /api/site/tg-auth с тем же SITE_LEAD_TOKEN, пускает только
# владельцев из /admins), а кнопочный каталог бота в чате выключается —
# витрина одна. Пусто — витрина своя, как раньше.
# SITE_URL=
