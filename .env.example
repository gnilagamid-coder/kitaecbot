# Скопируйте в .env и заполните.  cp .env.example .env

# Токен бота от @BotFather. Без него не работают: сам бот, аватарки
# пользователей, уведомления менеджеру и публикация в канал.
BOT_TOKEN=123456:AA...

# Пароль входа в /admin.html. Придумайте длинный, это единственная защита админки.
ADMIN_TOKEN=смените-обязательно

# Внутренний порт. Наружу его отдаёт nginx, слушаем только localhost.
PORT=3000
HOST=127.0.0.1

# Публичный адрес магазина со схемой. Нужен, чтобы Telegram мог забрать
# фото товара при публикации в канал.
PUBLIC_URL=https://shop.example.com

# Где лежат данные (файлы и картинки). По умолчанию ./data
DATA_DIR=./data

# Чем хранить: file (JSON-файлы, по умолчанию) или sqlite (одна база).
# sqlite требует Node 22.5+ и переезда данных — см. README, раздел
# «Где лежат данные». Просто дописать строку недостаточно: сначала
#   node scripts/migrate-to-sqlite.js --data ./data
# STORE_BACKEND=file

# Метка магазина в логах. Нужна, когда на сервере несколько магазинов —
# иначе непонятно, чей бот ругается.
# SHOP_ID=

# Как бот получает сообщения: polling (по умолчанию) или webhook.
#   polling — работает сразу, даже пока домен и сертификат не готовы, сам
#             переподключается после сбоев сети. Для одного сервера — лучший выбор.
#   webhook — Telegram сам стучится на PUBLIC_URL/api/webhook. Нужен рабочий HTTPS
#             на порту 443/80/88/8443. Имеет смысл, только если ставите несколько
#             экземпляров за балансировщиком или ловите тысячи сообщений в минуту.
# Отдельный секрет заводить не нужно — он выводится из BOT_TOKEN и ADMIN_TOKEN.
BOT_MODE=polling

# Адрес Bot API. Меняйте, только если сервер не может достучаться до Telegram
# напрямую (типичная история у российских хостеров: блокировка по IP или DPI).
# Укажите свой обратный прокси или локальный telegram-bot-api — БЕЗ /bot<token>.
# Проверить, есть ли проблема:  curl -sS -m 10 https://api.telegram.org | head
# TELEGRAM_API_BASE=https://tg-proxy.example.com
